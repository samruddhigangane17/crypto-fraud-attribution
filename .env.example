# ==========================================
# Real-Time Crypto Fraud Attribution System
# Environment Configuration
# ==========================================

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Managed Services (Member 3)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# REQUIRED outside local dev: Supabase dashboard -> Project Settings -> API -> JWT Secret.
# Without it, protected endpoints return 503 unless ALLOW_DEV_AUTH_STUB=true.
SUPABASE_JWT_SECRET=
# Local development ONLY: accept any well-formed Bearer token (unverified). Never enable in production.
ALLOW_DEV_AUTH_STUB=false
SUPABASE_STORAGE_BUCKET=evidence-reports

# Feature Flags
ENABLE_DEMO_CASES=true

# Blockchain Data Providers (Member 1)
ETHERSCAN_API_KEY=your-etherscan-api-key
BLOCKSTREAM_API_BASE=https://blockstream.info/api
TRONGRID_API_KEY=your-trongrid-api-key
BSCSCAN_API_KEY=your-bscscan-api-key
# Etherscan free tier ~5 calls/s. Minimum seconds between requests, and base retry backoff.
ETHERSCAN_MIN_INTERVAL=0.25
ETHERSCAN_RETRY_DELAY=1.0

# Member 2 Monitoring & Scoring Defaults
MONITORING_DEFAULT_INTERVAL_SECONDS=300
DEFAULT_HOP_LIMIT=4
PDF_REPORTS_OUTPUT_DIR=./generated_reports
